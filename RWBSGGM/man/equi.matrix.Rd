\name{equi.matrix}
\alias{equi.matrix}
\title{Generate an equicorrelation matrix}
\description{
Generates an equicorrelation matrix with unit diagonal and common
off-diagonal entries equal to 0.4.
}
\usage{
equi.matrix(d)
}
\arguments{
  \item{d}{The dimension of the matrix.}
}
\value{
A \code{d} by \code{d} equicorrelation matrix.
}
